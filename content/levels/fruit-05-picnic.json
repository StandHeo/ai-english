          { "id": "apple", "image": "assets/items/apple.png", "correct": true },
          { "id": "grape", "image": "assets/items/grape.png", "correct": false }
        ]
      }
    },
    {
      "type": "ask",
      "show": "assets/items/banana.png",
      "npc_say": "What's this?",
      "expect": ["banana", "a banana"],
      "hint_say": "Banana!",
      "fallback": {
        "type": "picture_choice",
        "options": [
          { "id": "banana", "image": "assets/items/banana.png", "correct": true },
          { "id": "orange", "image": "assets/items/orange.png", "correct": false }
        ]
      }
