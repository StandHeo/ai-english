      "show": "assets/items/strawberry.png",
      "npc_say": "What's this?",
      "expect": ["strawberry", "a strawberry"],
      "hint_say": "Strawberry!",
      "fallback": {
        "type": "picture_choice",
        "options": [
          { "id": "strawberry", "image": "assets/items/strawberry.png", "correct": true },
          { "id": "orange", "image": "assets/items/orange.png", "correct": false }
        ]
      }
    },
    {
      "type": "ask",
      "show": "assets/items/watermelon.png",
      "npc_say": "What's this?",
      "expect": ["watermelon", "a watermelon"],
