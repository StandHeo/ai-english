# API env example
PORT=8787

# —— 会员资格（SQLite，不含 LLM Key 列；日记生产继续 BYOK）——
# DATABASE_PATH=/var/lib/tudoudou/membership.db
# 若未设 DATABASE_PATH，则用 DATA_DIR/membership.db（默认 ./data/membership.db）
# DATA_DIR=data
DATABASE_PATH=./data/membership.db
# 产品默认家长登录通道（ParentPage 走邮箱）。短信 API 仍可用。
# AUTH_CHANNEL=email
EMAIL_PROVIDER=mock
# mock 验证码默认 123456，也会打在 API 日志里
# MOCK_EMAIL_CODE=123456
SMS_PROVIDER=mock
# mock 短信验证码默认 123456（短信路由保留，非产品默认）
# MOCK_SMS_CODE=123456

# Nginx 后识别客户端 IP（默认 1 跳）。直连公网不要信转发头时设 0 / off
# TRUST_PROXY=1
# 验证码发送 IP 滑动窗口限流（邮箱与短信共用；邮箱超限 error=auth_ip_rate_limited，短信仍为 sms_ip_rate_limited）
# SMS_IP_LIMIT_WINDOW_MS=60000
# SMS_IP_LIMIT_MAX=10
# 可选：同一 IP 滚动 24h 发送上限（不设或 0 表示关闭）
# SMS_IP_DAILY_MAX=50
# 校验接口较宽松的 IP 限流，抑制爆破
# SMS_VERIFY_IP_LIMIT_MAX=30
# 图形验证码（默认 off）。AUTH_CAPTCHA 或 SMS_CAPTCHA 任一为 on 时，邮箱与短信发送都要 captcha
# AUTH_CAPTCHA=off
# SMS_CAPTCHA=off

BILLING_PROVIDER=manual
# 手工开通：POST /api/admin/plus  Authorization: Bearer $ADMIN_TOKEN
# body: {"email":"parent@example.com","plan":"month"|"year"}
# 旧手机号行仍可用 {"phone":"13800138000","plan":"month"}
# 运营后台（只读查询 + 可选开通）：GET /api/admin/ui/  登录框填同一 ADMIN_TOKEN
# ADMIN_TOKEN=
# SESSION_TTL_DAYS=14

# SMTP 发信（EMAIL_PROVIDER=smtp 才走 SMTP；企业/QQ 备选。个人实名腾讯云 SES 不能 SMTP）
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=on
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="土豆豆AI英语 <noreply@example.com>"

# 生产发信（个人实名腾讯云 SES：2026-03-02 起不能 SMTP，必须 API + 已审核模板）
# EMAIL_PROVIDER=tencent_ses
# TENCENT_SES_SECRET_ID=
# TENCENT_SES_SECRET_KEY=
# 也可共用云 API 密钥（SES 未设时回落）：
# TENCENT_CLOUD_SECRET_ID=
# TENCENT_CLOUD_SECRET_KEY=
# TENCENT_SES_REGION=ap-guangzhou
# TENCENT_SES_FROM=noreply@mail.tudoudou-ai.site
# 控制台创建验证码模板，变量名必须为 code，例如「您的验证码是{{code}}」
# TENCENT_SES_TEMPLATE_ID=
# TENCENT_SES_SUBJECT=土豆豆AI英语 登录验证码

# 生产短信（SMS_PROVIDER=tencent 才走腾讯云；资质未就绪时保持 mock，路由仍保留）
# SMS_PROVIDER=tencent
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

# 微信支付（BILLING_PROVIDER=wechat 才下单；商户未就绪保持 manual）
# BILLING_PROVIDER=wechat
# WECHAT_PAY_MCHID=
# WECHAT_PAY_APPID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_NOTIFY_URL=https://example.com/api/billing/wechat/notify
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=
# mock：不再用期望词假装听懂；真正文字来自浏览器语音识别（HTTPS）或 openai
ASR_PROVIDER=mock
TTS_PROVIDER=browser
# ASR_PROVIDER=openai
# ASR_API_KEY=
# ASR_MODEL=whisper-1
# TTS_API_KEY=

# 家庭日记关卡生成（DeepSeek 默认；请求体 llm=agnes 走 Agnes）
# FAMILY_LLM_PROVIDER=deepseek
# FAMILY_LLM_PROVIDER=mock
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# AGNES_API_KEY=
# AGNES_LLM_MODEL=agnes-2.5-flash

# 家庭关卡自动配图（通义万相 / Agnes 图）
# FAMILY_IMAGE_PROVIDER=tongyi
# FAMILY_IMAGE_PROVIDER=agnes
# FAMILY_IMAGE_PROVIDER=mock
# DASHSCOPE_API_KEY=
# 或 TONGYI_API_KEY=
# TONGYI_IMAGE_MODEL=wan2.6-t2i
# TONGYI_IMAGE_MAX=4
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# 可选覆盖默认北京地域端点：
# TONGYI_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
