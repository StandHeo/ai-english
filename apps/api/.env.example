# API env example
PORT=8787

# —— 会员资格（SQLite，不含 LLM Key 列；日记生产继续 BYOK）——
# DATABASE_PATH=/var/lib/tudoudou/membership.db
# 若未设 DATABASE_PATH，则用 DATA_DIR/membership.db（默认 ./data/membership.db）
# DATA_DIR=data
DATABASE_PATH=./data/membership.db
SMS_PROVIDER=mock
# mock 验证码默认 123456，也会打在 API 日志里
# MOCK_SMS_CODE=123456

# Nginx 后识别客户端 IP（默认 1 跳）。直连公网不要信转发头时设 0 / off
# TRUST_PROXY=1
# 短信发送 IP 滑动窗口限流（始终开启；超限 error=sms_ip_rate_limited）
# SMS_IP_LIMIT_WINDOW_MS=60000
# SMS_IP_LIMIT_MAX=10
# 可选：同一 IP 滚动 24h 发送上限（不设或 0 表示关闭）
# SMS_IP_DAILY_MAX=50
# 校验接口较宽松的 IP 限流，抑制爆破
# SMS_VERIFY_IP_LIMIT_MAX=30
# 图形验证码（默认 off，mock/开发不必填）。on 时 GET /api/auth/captcha，发送须带 captchaId + captchaAnswer
# SMS_CAPTCHA=off

BILLING_PROVIDER=manual
# 手工开通：POST /api/admin/plus  Authorization: Bearer $ADMIN_TOKEN
# body: {"phone":"13800138000","plan":"month"|"year"}
# ADMIN_TOKEN=
# SESSION_TTL_DAYS=14

# 生产短信（SMS_PROVIDER=tencent 才走腾讯云；缺密钥时明确失败，不影响 mock）
# SMS_PROVIDER=tencent
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

# 微信支付（BILLING_PROVIDER=wechat 才下单；商户未就绪保持 manual）
# BILLING_PROVIDER=wechat
# WECHAT_PAY_MCHID=
# WECHAT_PAY_APPID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_NOTIFY_URL=https://example.com/api/billing/wechat/notify
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=
# mock：不再用期望词假装听懂；真正文字来自浏览器语音识别（HTTPS）或 openai
ASR_PROVIDER=mock
TTS_PROVIDER=browser
# ASR_PROVIDER=openai
# ASR_API_KEY=
# ASR_MODEL=whisper-1
# TTS_API_KEY=

# 家庭日记关卡生成（DeepSeek 默认；请求体 llm=agnes 走 Agnes）
# FAMILY_LLM_PROVIDER=deepseek
# FAMILY_LLM_PROVIDER=mock
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# AGNES_API_KEY=
# AGNES_LLM_MODEL=agnes-2.5-flash

# 家庭关卡自动配图（通义万相 / Agnes 图）
# FAMILY_IMAGE_PROVIDER=tongyi
# FAMILY_IMAGE_PROVIDER=agnes
# FAMILY_IMAGE_PROVIDER=mock
# DASHSCOPE_API_KEY=
# 或 TONGYI_API_KEY=
# TONGYI_IMAGE_MODEL=wan2.6-t2i
# TONGYI_IMAGE_MAX=4
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# 可选覆盖默认北京地域端点：
# TONGYI_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
